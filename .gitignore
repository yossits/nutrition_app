# ---------------------------------------------------------------------------
# SECRETS - never commit these. An API key pushed to GitHub is scraped within
# minutes by bots that watch the public event stream.
# ---------------------------------------------------------------------------
.env
.env.*
*.env
secrets.json
credentials.json
*.key
*.pem
api_key*
ANTHROPIC_API_KEY*

