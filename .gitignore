# ---------------------------------------------------------------------------
menus.html
spike_output.txt
*.log
db/*_report.txt
# Generated by db/09_export_menu_foods.py from v_menu_foods. spike/foods.py,
# the hand-written seed, is NOT this file and stays tracked.
spike/menu_foods.py

